      "title": "Starter Activity: Particle Model Retrieval Grid",
      "imageFileName": "slide_02.png",
      "imageUrl": "/decks/physics_matter_pressure_heat/Lesson_02_Pressure_Alternative/slides/slide_02.png",
      "isInteractive": true,
