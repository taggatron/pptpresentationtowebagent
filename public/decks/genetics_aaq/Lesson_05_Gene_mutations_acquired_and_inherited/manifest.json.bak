      "number": 2,
      "title": "Starter Activity: 6-Cell Knowledge Retrieval",
      "imageFileName": "slide_02.png",
      "imageUrl": "/decks/genetics_aaq/Lesson_05_Gene_mutations_acquired_and_inherited/slides/slide_02.png",
      "sourceMediaPath": "ppt/media/image2.png",
      "isInteractive": true,
      "interactiveType": "six_cell_grid",
      "starterQuestions": [
        {
          "q": "What is the key difference in transmission between an acquired somatic mutation and an inherited germline mutation?",
          "a": "Acquired somatic mutations occur in body tissues and cannot be passed to offspring; germline mutations occur in gametes and are heritable across generations."
        },
        {
          "q": "Which molecular type of mutation introduces a premature stop codon into mRNA, truncating the polypeptide?",
          "a": "A nonsense mutation."
        },
        {
          "q": "Which specific trinucleotide triplet is expanded in Huntington's disease, and which amino acid does it encode?",
          "a": "The CAG repeat, which encodes the amino acid glutamine (forming an expanded polyglutamine / polyQ tract)."
        },
        {
          "q": "What is the threshold number of CAG repeats in the HTT gene required for full penetrance of Huntington's disease?",
          "a": "40 or more CAG repeats (>=40 CAG repeats)."
        },
        {
          "q": "Define the genetic phenomenon of 'anticipation' observed in Huntington's disease pedigrees.",
          "a": "The onset of symptoms occurs at progressively earlier ages and with greater severity in successive generations due to intergenerational repeat expansion."
        },
        {
          "q": "Which parent's germline is most prone to massive CAG repeat expansion during gametogenesis in Huntington's families?",
          "a": "The father's germline (paternal transmission during spermatogenesis)."
        }
      ],
