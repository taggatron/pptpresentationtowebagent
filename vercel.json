{
  "version": 2,
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/decks/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/decks/**/manifest.json,data/**}",
      "excludeFiles": "{public/**/*.{png,jpg,jpeg,mp4,pptx,pdf,xlsx,gif,webp,webm},public/decks/**/slides/**,output/**,scratch/**}"
    }
  }
}

